# Cookies de uma conta Steam logada (steamcommunity.com > DevTools > Application > Cookies).
# Necessários para consultar pelo link de troca.
STEAM_SESSIONID=
STEAM_LOGIN_SECURE=

# Fonte de preços: csgotrader (JSON da extensão CS2 Trader, sem login — padrão) ou youpin (API direta, exige token)
PRICE_SOURCE=csgotrader
# URL do JSON do CS2 Trader (opcional; por padrão tenta prices.csgotrader.app/latest/youpin898.json)
CSGOTRADER_URL=
# Câmbio fixo opcional (senão busca automático)
USD_BRL_RATE=

# Token de login do YouPin898 (header "authorization" de uma requisição logada em youpin898.com).
# Sem ele o YouPin costuma recusar as consultas.
YOUPIN_TOKEN=
# Opcional: device id/uk que o site manda nas requisições
YOUPIN_DEVICE_ID=
YOUPIN_BASE_URL=https://api.youpin898.com

# Conversão CNY -> BRL. Se vazio, busca a cotação automática (AwesomeAPI).
CNY_BRL_RATE=

# Fator aplicado sobre o valor (ex.: 0.9 = paga 90% do preço). Padrão 1.
PRICE_FACTOR=1

# Só responde a esses números (ex.: 5511999999999,5521988888888). Vazio = qualquer um.
ALLOWED_NUMBERS=
# Prefixo dos comandos
PREFIX=!
CACHE_TTL_MINUTES=15

# Vincular por código de 8 dígitos em vez de QR (ex.: 5511999999999). Bom para servidor.
PAIR_PHONE=
# Onde guardar a sessão do WhatsApp (na nuvem, aponte para um volume persistente)
SESSION_DIR=.wwebjs_auth
